cabal-version:      3.0
name:               experiment
version:            0.1.0.0

license:            MIT
license-file:       LICENSE
author:             Clemens Schmid
maintainer:         clemens@nevrome.de
category:           Web
build-type:         Simple

extra-doc-files:    README.md

common warnings
    ghc-options: -Wall

executable experiment
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    build-depends:
        base
    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:
        -optl-mexec-model=reactor
        -optl-Wl,--export=hs_init
        -optl-Wl,--export=hs_sayHello
        -optl-Wl,--export=callocBuffer
        -optl-Wl,--export=freeBuffer
